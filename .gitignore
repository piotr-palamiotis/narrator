.venv/
__pycache__/
*.pyc
dist/
build/
*.spec.bak
scripts/output/
.pytest_cache/
*.egg-info/

# Piper TTS voice fixture binaries (fetched via piper.download_voices, see
# scripts/gen_test_clips.py) -- large, reproducible, not committed.
/pl_PL-darkman-medium.onnx
/pl_PL-darkman-medium.onnx.json

# Real-recording fixtures (scripts/test_audio/*): operator-provided audio +
# SRT transcripts of real events -- large and private, never committed.
# The .srt files stay committable via an explicit `git add -f` if wanted.
/scripts/test_audio/*
!/scripts/test_audio/README.md

# Self-contained layout: everything the app writes lives under the repo.
# var/ = logs, web-ui.json, and narrator-tune's working data
# (var/tune/: decoded excerpt cache, resumable result store, run reports).
# scripts/autoconfigure_* is the pre-narrator-tune location, still used
# until moved to var/tune/.
var/
/config/config.yaml
/config/tune.yaml
/models/
/third_party/
/scripts/autoconfigure_cache/
/scripts/autoconfigure_reports/

# Local reference recording (86 MB, real event audio): kept out of pushes.
/test.aac
/test.srt
